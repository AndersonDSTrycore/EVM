                             references="tbl_actividades(id)"/>
            </column>
            <column name="id_usuario" type="bigint">
                <constraints nullable="false"
                             foreignKeyName="fk_asignaciones_usuario"
                             references="tbl_usuarios(id)"/>
            </column>
            <column name="id_estado_asignacion" type="bigint">
                <constraints nullable="false"
                             foreignKeyName="fk_asignaciones_estado_asignacion"
                             references="tbl_estados_asignaciones(id)"/>
            </column>
            <column name="fecha_asignacion" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="fecha_retiro" type="timestamp"/>
            <column name="fecha_creacion" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="fecha_modificacion" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
