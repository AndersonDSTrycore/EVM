    <!-- tbl_usuarios -->
    <changeSet id="001-07-crear-tbl-usuarios" author="evm-team">
        <createTable tableName="tbl_usuarios">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="id_rol_sistema" type="bigint">
                <constraints nullable="false"
                             foreignKeyName="fk_usuarios_rol_sistema"
                             references="tbl_roles_sistema(id)"/>
            </column>
            <column name="id_cargo" type="bigint">
                <constraints nullable="false"
                             foreignKeyName="fk_usuarios_cargo"
                             references="tbl_cargos(id)"/>
            </column>
            <column name="id_estado_usuario" type="bigint">
                <constraints nullable="false"
                             foreignKeyName="fk_usuarios_estado_usuario"
                             references="tbl_estados_usuarios(id)"/>
            </column>
            <column name="nombre" type="varchar(150)">
                <constraints nullable="false"/>
            </column>
            <column name="correo" type="varchar(200)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_usuarios_correo"/>
            </column>
            <column name="contrasena" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="fecha_creacion" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="fecha_modificacion" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- tbl_proyectos -->
    <changeSet id="001-08-crear-tbl-proyectos" author="evm-team">
        <createTable tableName="tbl_proyectos">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="id_estado_proyecto" type="bigint">
                <constraints nullable="false"
                             foreignKeyName="fk_proyectos_estado_proyecto"
                             references="tbl_estados_proyectos(id)"/>
            </column>
            <column name="nombre" type="varchar(200)">
                <constraints nullable="false"/>
            </column>
            <column name="descripcion" type="text"/>
            <column name="fecha_inicio" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="fecha_fin" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="presupuesto_total" type="numeric(18,2)">
                <constraints nullable="false"/>
            </column>
            <column name="fecha_creacion" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="fecha_modificacion" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- tbl_actividades -->
    <changeSet id="001-09-crear-tbl-actividades" author="evm-team">
        <createTable tableName="tbl_actividades">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="id_proyecto" type="bigint">
                <constraints nullable="false"
                             foreignKeyName="fk_actividades_proyecto"
                             references="tbl_proyectos(id)"/>
            </column>
            <column name="id_estado_actividad" type="bigint">
                <constraints nullable="false"
                             foreignKeyName="fk_actividades_estado_actividad"
                             references="tbl_estados_actividades(id)"/>
            </column>
            <column name="nombre" type="varchar(200)">
                <constraints nullable="false"/>
            </column>
            <column name="descripcion" type="text"/>
            <column name="bac" type="numeric(18,2)">
                <constraints nullable="false"/>
            </column>
            <column name="porcentaje_avance_planificado" type="numeric(5,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="porcentaje_avance_real" type="numeric(5,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="fecha_inicio" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="fecha_fin" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="fecha_creacion" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="fecha_modificacion" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- tbl_asignaciones_actividades -->
