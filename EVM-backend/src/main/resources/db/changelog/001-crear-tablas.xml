            </column>
            <column name="id_usuario_registra" type="bigint">
                <constraints nullable="false"
                             foreignKeyName="fk_registros_horas_usuario_registra"
                             references="tbl_usuarios(id)"/>
            </column>
            <column name="fecha_trabajo" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="horas_trabajadas" type="numeric(6,2)">
                <constraints nullable="false"/>
            </column>
            <column name="valor_hora_historico" type="numeric(15,2)">
                <constraints nullable="false"/>
            </column>
            <column name="costo_total" type="numeric(18,2)">
                <constraints nullable="false"/>
            </column>
            <column name="descripcion" type="text"/>
            <column name="fecha_creacion" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="fecha_modificacion" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
