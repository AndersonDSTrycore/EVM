<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- =========================================================
         001 - Creación de tablas del modelo de base de datos
         Autor: evm-team
         Fuente: /docs/02-modelo-base-datos.md
         ========================================================= -->

    <!-- tbl_roles_sistema -->
    <changeSet id="001-01-crear-tbl-roles-sistema" author="evm-team">
        <createTable tableName="tbl_roles_sistema">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="codigo" type="varchar(50)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_roles_sistema_codigo"/>
            </column>
            <column name="nombre" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="descripcion" type="text"/>
            <column name="activo" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="fecha_creacion" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="fecha_modificacion" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- tbl_cargos -->
    <changeSet id="001-02-crear-tbl-cargos" author="evm-team">
        <createTable tableName="tbl_cargos">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nombre" type="varchar(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_cargos_nombre"/>
            </column>
            <column name="descripcion" type="text"/>
            <column name="valor_hora" type="numeric(15,2)">
                <constraints nullable="false"/>
            </column>
            <column name="activo" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="fecha_creacion" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="fecha_modificacion" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

