    <!-- tbl_estados_asignaciones -->
    <changeSet id="001-06-crear-tbl-estados-asignaciones" author="evm-team">
        <createTable tableName="tbl_estados_asignaciones">
            <column name="id" type="bigint" autoIncrement="true">
