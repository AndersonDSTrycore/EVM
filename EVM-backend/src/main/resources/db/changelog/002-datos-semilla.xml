        <insert tableName="tbl_usuarios">
            <column name="id" value="1"/>
            <column name="id_rol_sistema" value="1"/>
            <column name="id_cargo" value="1"/>
            <column name="id_estado_usuario" value="1"/>
            <column name="nombre" value="Líder Demo"/>
            <column name="correo" value="lider.demo@evm.local"/>
            <column name="contrasena" value="$2a$10$1OC1Eu5QUVuX9kAqgriei.LudVkExoTeKZQnWklTxA0qUhv5kJJ/G"/>
            <column name="fecha_creacion" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="fecha_modificacion" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>
        <insert tableName="tbl_usuarios">
            <column name="id" value="2"/>
            <column name="id_rol_sistema" value="2"/>
            <column name="id_cargo" value="2"/>
            <column name="id_estado_usuario" value="1"/>
            <column name="nombre" value="Colaborador Demo"/>
            <column name="correo" value="colaborador.demo@evm.local"/>
            <column name="contrasena" value="$2a$10$V5T/bOTgZZIS22URtpgbau5DTpzp8XmsYqDE.HtCPoeerWFN0tM6S"/>
            <column name="fecha_creacion" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="fecha_modificacion" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>
        <rollback>
            <delete tableName="tbl_usuarios">
                <where>correo IN ('lider.demo@evm.local', 'colaborador.demo@evm.local')</where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>
